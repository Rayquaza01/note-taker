{
    "name": "note-taker",
    "version": "1.0.0",
    "description": "Adds a text box to a toolbar button for taking notes",
    "main": "index.js",
    "scripts": {
        "lint": "web-ext lint --source-dir ./dist",
        "build:watch": "webpack --config webpack.config.js --mode=development --watch",
        "build:extension": "web-ext build -s ./dist",
        "build:i18n": "python ./scripts/i18n.py --",
        "firefox": "web-ext run --source-dir ./dist --"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rayquaza01/note-taker.git"
    },
    "author": "Rayquaza01",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Rayquaza01/note-taker/issues"
    },
    "homepage": "https://github.com/Rayquaza01/note-taker#readme",
    "dependencies": {
        "@mdi/js": "^7.2.96",
        "@mdi/react": "^1.6.1",
        "@types/react": "^18.0.38",
        "@types/react-dom": "^18.0.11",
        "dexie": "^3.2.3",
        "dexie-react-hooks": "^1.1.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/webextension-polyfill": "^0.10.0",
        "@typescript-eslint/eslint-plugin": "^5.59.1",
        "@typescript-eslint/parser": "^5.59.1",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.7.3",
        "css-minimizer-webpack-plugin": "^5.0.0",
        "eslint": "^8.39.0",
        "html-webpack-plugin": "^5.5.1",
        "mini-css-extract-plugin": "^2.7.5",
        "style-loader": "^3.3.2",
        "terser-webpack-plugin": "^5.3.7",
        "ts-loader": "^9.4.2",
        "typescript": "^5.0.4",
        "web-ext": "^0.0.1",
        "webextension-polyfill": "^0.10.0",
        "webpack": "^5.80.0",
        "webpack-cli": "^5.0.2"
    }
}
